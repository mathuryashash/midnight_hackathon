# ─────────────────────────────────────────────────────────────────────────────
# MidnightOTC Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend ──────────────────────────────────────────────────────────────────

# Set to "true" for demo/testing without a Midnight node or wallet
# Set to "false" for real testnet deployment
NEXT_PUBLIC_USE_MOCK=true

# Relayer WebSocket URL
NEXT_PUBLIC_RELAYER_URL=ws://localhost:3001

# ── Relayer ───────────────────────────────────────────────────────────────────

RELAYER_PORT=3001            # HTTP + WebSocket listen port
RELAYER_HOST=0.0.0.0         # Listen address
MATCH_INTERVAL_MS=5000       # How often to scan for matches (ms)
MAX_ORDERS=10000             # Max open orders in memory
WS_MAX_PAYLOAD=65536         # Max WebSocket message size (bytes)
RATE_LIMIT_CAPACITY=120      # Token-bucket capacity (burst allowance)
RATE_LIMIT_REFILL=60         # Token-bucket refill rate (tokens/sec)
PEER_ORDER_LIMIT=50          # Max active orders per peer
LOG_LEVEL=info               # Logger level (debug, info, warn, error)
TLS_KEY_PATH=                # Path to TLS private key (set with TLS_CERT_PATH for WSS)
TLS_CERT_PATH=               # Path to TLS certificate (set with TLS_KEY_PATH for WSS)
AUTH_ENABLED=false           # Enable API key auth on WS/HTTP
RELAYER_API_KEY=             # API key for relayer authentication (if AUTH_ENABLED=true)

# ── Midnight Node (for testnet deployment) ───────────────────────────────────

# Local node (Docker)
MIDNIGHT_NODE_URL=ws://localhost:9944

# Midnight Testnet
# MIDNIGHT_NODE_URL=wss://rpc.testnet.midnight.network

# Indexer URL
MIDNIGHT_INDEXER_URL=http://localhost:3500

# Proof server URL
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

# ── Contract ──────────────────────────────────────────────────────────────────

# Set after deploying the contract
# CONTRACT_ADDRESS=0x...

# ── Identity (production) ────────────────────────────────────────────────────

# Identity verifier endpoint for W3C Verifiable Credentials
# IDENTITY_VERIFIER_URL=https://your-verifier.example.com

# Threshold: require N of M verifier signatures
# IDENTITY_THRESHOLD_N=2
# IDENTITY_THRESHOLD_M=3
